DATABASE_URL="postgresql://geo:geo_dev_pw@localhost:5435/geo_grilagem?schema=public"
# Banco descartável exclusivo para validação de migrations (opcional).
SHADOW_DATABASE_URL="postgresql://geo:geo_dev_pw@localhost:5436/geo_grilagem_shadow?schema=public"
JWT_SECRET="dev_super_secret_change_in_prod"
JWT_EXPIRES_IN="8h"
REGISTRATION_ENABLED="true"
# Em produção, deixe false durante a primeira fase do rolling deploy e só habilite após drenar pods antigos.
CASE_DRAFTS_ENABLED="true"
# Vazio desabilita o bootstrap. Gere um segredo aleatório (mínimo 32 caracteres) apenas na instalação.
ADMIN_BOOTSTRAP_SECRET=""
PORT=3001
MINIO_ENDPOINT="localhost"
MINIO_PORT=9004
# Credencial da aplicação, sem s3:PutBucketPolicy. Nunca use a conta root aqui.
MINIO_ACCESS_KEY="geo_app"
MINIO_SECRET_KEY="geo_app_dev_pw_123"
MINIO_BUCKET="geo-datasets"
MINIO_PUBLIC_URL="http://localhost:9004"
REDIS_URL="redis://localhost:6381"
WEB_ORIGIN="http://localhost:3000"

# ---- Credenciais de acesso padrão (somente desenvolvimento/beta) ----
# Contas criadas por `pnpm --filter api run seed:usuarios`, uma por papel.
# Defina uma senha própria (mínimo 8 caracteres) para cada conta que quiser criar;
# senha vazia pula aquele papel. O seed não sobrescreve contas que já existem e
# se recusa a rodar com NODE_ENV=production. Nunca use estas senhas fora do ambiente de testes.
SEED_ADMIN_EMAIL="admin@observatorio.local"
SEED_ADMIN_PASSWORD=""
SEED_VERIFICADOR_EMAIL="verificador@observatorio.local"
SEED_VERIFICADOR_PASSWORD=""
SEED_PESQUISADOR_ENVIO_DOWNLOAD_EMAIL="pesquisador.download@observatorio.local"
SEED_PESQUISADOR_ENVIO_DOWNLOAD_PASSWORD=""
SEED_PESQUISADOR_ENVIO_EMAIL="pesquisador@observatorio.local"
SEED_PESQUISADOR_ENVIO_PASSWORD=""
SEED_VISUALIZADOR_EMAIL="visualizador@observatorio.local"
