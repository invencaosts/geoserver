generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, pg_trgm]
}

enum RoleName {
  admin
  verificador
  contribuidor
  leitor
}

enum UserStatus {
  ativo
  inativo
}

enum RoleApprovalStatus {
  pendente
  aprovado
  rejeitado
}

enum PerfilContribuidor {
  pesquisador
  militante_movimento_social
  partido_politico
  servidor_publico
  lideranca_comunitaria
  movimento_social_organizado
  conselhos_ongs
}

enum InstituicaoTipo {
  educacao_basica
  educacao_superior
}

model Instituicao {
  id          String          @id @default(cuid())
  nome        String
  municipio   String
  uf          String
  tipo        InstituicaoTipo
  dependencia String?

  @@index([nome(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("instituicoes")
}

model User {
  id                  String              @id @default(cuid())
  nome                String
  nomeSocial          String?
  email               String              @unique
  cpf                 String?             @unique
  senhaHash           String
  role                RoleName            @default(leitor)
  requestedRole       RoleName            @default(leitor)
  roleApprovalStatus  RoleApprovalStatus  @default(aprovado)
  perfilContribuidor  PerfilContribuidor?
  localidade          String?
  quemRepresenta      String?
  telefone            String?
  instituicao         String?
  endereco            String?
  idiomas             String[]            @default([])
  areasInteresse      String[]            @default([])
  status              UserStatus          @default(ativo)
  avatarUrl           String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  casesCreated       Case[]              @relation("CaseCreatedBy")
  statusChanges      CaseStatusHistory[] @relation("StatusChangedBy")
  notifications      Notification[]

  @@map("users")
}

enum NotificationTipo {
  contribuicao_aceita
  contribuicao_retorno
  novo_caso_area_interesse
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipo      NotificationTipo
  titulo    String
  mensagem  String
  lida      Boolean          @default(false)
  caseId    String?
  case      Case?            @relation(fields: [caseId], references: [id], onDelete: SetNull)
  createdAt DateTime         @default(now())

  @@index([userId, lida])
  @@map("notifications")
}

enum LayerType {
  WMS
  WFS
  WCS
  Vector
  Raster
}

enum LayerCategory {
  base
  overlay
  analysis
}

model Layer {
  id           String        @id @default(cuid())
  nome         String
  tipo         LayerType
  categoria    LayerCategory @default(overlay)
  url          String?
  fonte        String
  descricao    String?
  projecao     String        @default("EPSG:4326")
  visivel      Boolean       @default(true)
  opacidade    Int           @default(100)
  tileSourceId String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("layers")
}

enum DatasetFormat {
  Shapefile
  GeoJSON
  KML
  KMZ
  CSV
  PDF
}

enum DatasetGeomType {
  Point
  Polygon
  Line
}

enum DatasetStatus {
  processing
  active
  error
}

model Dataset {
  id               String          @id @default(cuid())
  nome             String
  formato          DatasetFormat
  tipoGeometria    DatasetGeomType
  status           DatasetStatus   @default(processing)
  registros        Int             @default(0)
  projecaoOriginal String?
  storageKey       String?
  erro             String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  features Feature[]

  @@map("datasets")
}

model Feature {
  id         String                @id @default(cuid())
  datasetId  String
  dataset    Dataset               @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  geom       Unsupported("geometry(Geometry,4326)")
  properties Json                  @default("{}")
  createdAt  DateTime              @default(now())

  @@index([datasetId])
  @@map("features")
}

enum CaseTipo {
  institucional
  titulo_falso
  car
}

enum CasePrioridade {
  baixa
  media
  alta
  critica
}

enum CaseStatus {
  pendente
  em_verificacao
  validado
  rejeitado
}

model Case {
  id          String         @id @default(cuid())
  nome        String
  tipo        CaseTipo
  municipio   String
  estado      String
  descricao   String?
  lat         Float?
  lng         Float?
  fonteDados  String?
  denunciante String?
  prioridade  CasePrioridade @default(media)
  status      CaseStatus     @default(pendente)

  anexoUrl   String?
  anexoNome  String?
  anexoKey   String?

  createdById String
  createdBy   User   @relation("CaseCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusHistory CaseStatusHistory[]
  notifications Notification[]

  @@index([status])
  @@index([municipio])
  @@map("cases")
}

model CaseStatusHistory {
  id          String      @id @default(cuid())
  caseId      String
  case        Case        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  fromStatus  CaseStatus?
  toStatus    CaseStatus
  changedById String
  changedBy   User        @relation("StatusChangedBy", fields: [changedById], references: [id])
  note        String?
  createdAt   DateTime    @default(now())

  @@index([caseId])
  @@map("case_status_history")
}

enum TimelineEscopo {
  nacional
  estadual
}

model TimelineEvent {
  id           String         @id @default(cuid())
  escopo       TimelineEscopo
  estado       String?
  startYear    Int?
  startMonth   Int?
  startDay     Int?
  endYear      Int?
  endMonth     Int?
  endDay       Int?
  displayDate  String?
  headline     String
  text         String         @db.Text
  mediaUrl     String?
  mediaCredit  String?
  mediaCaption String?
  mediaThumb   String?
  type         String?
  background   String?
  order        Int            @default(autoincrement())
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([estado])
  @@index([escopo])
  @@map("timeline_events")
}
