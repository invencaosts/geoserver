{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:ListAllMyBuckets"],
      "Resource": ["arn:aws:s3:::*"]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::geo-datasets",
        "arn:aws:s3:::avatars",
        "arn:aws:s3:::attachments",
        "arn:aws:s3:::case-evidence",
        "arn:aws:s3:::timeline-leis"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": [
        "arn:aws:s3:::geo-datasets/*",
        "arn:aws:s3:::avatars/*",
        "arn:aws:s3:::attachments/*",
        "arn:aws:s3:::case-evidence/*",
        "arn:aws:s3:::timeline-leis/*"
      ]
    }
  ]
}
