{
  "name": "geo-grilagem",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api start:dev",
    "build": "pnpm -r build",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,jsx,json,css}\" \"packages/**/*.{ts,tsx,js,json}\" \"*.{json,md}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,js,jsx,json,css}\" \"packages/**/*.{ts,tsx,js,json}\" \"*.{json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}
